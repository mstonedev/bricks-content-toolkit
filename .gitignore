
# Node.js dependencies and package-manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PHP / Composer dependencies
vendor/
composer.phar

# Environment files and local secrets
.env
.env.local
.env.*.local
!.env.example

# Generated build, test, cache, and temporary output
build/
dist/
coverage/
.cache/
.tmp/
temp/
logs/
*.log

# PHPUnit and PHP tool caches
.phpunit.result.cache
.phpunit.cache/
.phpstan.cache
.phpstan/
.psalm/

# Local WordPress state: this repository must not contain a full WP site
wp-admin/
wp-includes/
wp-content/uploads/
wp-config.php
wp-config-local.php
wordpress/

# Database exports and local database files
*.sql
*.sql.gz
*.sqlite
*.sqlite3

# Operating-system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# IDE/editor local state
.idea/
*.iml
*.code-workspace

# Keep shareable VS Code configuration, ignore personal workspace state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Local certificates and keys
*.pem
*.key
*.crt
*.p12
*.pfx

# Local dependency-management configuration
.auth.json